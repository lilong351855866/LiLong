.tabbar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 90rpx;
  background-color: #1e293b;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #334155;
  z-index: 999;
}
.tab-item {
  width: 33%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8892a0;
}
/* 选中文字：亮蓝色 + 蓝光发光光晕 */
.tab-item.active {
  color: #38bdf8;
  text-shadow: 0 0 10rpx #38bdf8,0 0 20rpx rgba(56,189,248,0.6);
}
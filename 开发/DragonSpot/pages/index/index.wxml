<view class="page-root">
  <!-- 顶部背景装饰 -->
  <view class="top-bg">
    <view class="gradient-circle circle-1"></view>
    <view class="gradient-circle circle-2"></view>
  </view>

  <!-- 标题区域 -->
  <view class="banner-box">
    <text class="banner-title">画龙点景</text>
    <text class="banner-sub">CG虚拟仿真作品展示平台</text>
  </view>

  <!-- 主轮播图 -->
  <view class="banner-img-box">
    <image class="show-img" src="{{currentImg}}" mode="aspectFill"></image>
    <view class="img-mask"></view>
  </view>

  <!-- 作品卡片区域 -->
  <view class="card-grid">
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="/images/thumb/UE5_GuMu1.jpg" mode="aspectFill"></image>
      <view class="card-label">虚拟场景</view>
    </view>
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="/images/thumb/UE5_SaiBo.jpg" mode="aspectFill"></image>
      <view class="card-label">奇幻世界观</view>
    </view>
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="/images/thumb/Ai_LianHuaPaoChe.jpg" mode="aspectFill"></image>
      <view class="card-label">游戏视觉</view>
    </view>
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="/images/thumb/Unity_ChongQing.jpg" mode="aspectFill"></image>
      <view class="card-label">实时渲染</view>
    </view>
  </view>

  <!-- 底部导航，首页激活发光 -->
  <tab-bar active="0"></tab-bar>
</view>
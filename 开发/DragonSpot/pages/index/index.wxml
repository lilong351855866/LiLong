<view class="page-root">
  <!-- 顶部背景装饰 -->
  <view class="top-bg">
    <view class="gradient-circle circle-1"></view>
    <view class="gradient-circle circle-2"></view>
  </view>

  <!-- 标题区域 -->
  <view class="banner-box">
    <text class="banner-title">工坊视界</text>
    <text class="banner-sub">CG虚拟仿真作品展示平台</text>
  </view>

  <!-- 主轮播图 -->
  <view class="banner-img-box">
    <image class="show-img" src="{{currentImg}}" mode="aspectFill"></image>
    <view class="img-mask"></view>
  </view>

  <!-- 作品卡片区域 -->
  <view class="card-grid">
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="{{cardList[0].img}}" mode="aspectFill"></image>
      <view class="card-label">虚拟仿真</view>
    </view>
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="{{cardList[1].img}}" mode="aspectFill"></image>
      <view class="card-label">赛博朋克</view>
    </view>
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="{{cardList[2].img}}" mode="aspectFill"></image>
      <view class="card-label">游戏视觉</view>
    </view>
    <view class="work-card" bindtap="switchToCg">
      <image class="card-img" src="{{cardList[3].img}}" mode="aspectFill"></image>
      <view class="card-label">实时渲染</view>
    </view>
  </view>

  <!-- 电影胶片横向滚动区域【赛博蓝光圆孔版】 -->
  <view class="film-container">
    <view class="film-perforation-top"></view>
    <view class="film-perforation-bottom"></view>
    <view class="film-inner">
      <view class="film-track">
        <image class="film-img" wx:for="{{filmImgList}}" wx:key="*this" src="{{item}}" mode="aspectFill"></image>
        <image class="film-img" wx:for="{{filmImgList}}" wx:key="copy_{*this}" src="{{item}}" mode="aspectFill"></image>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <tab-bar active="0"></tab-bar>
</view>
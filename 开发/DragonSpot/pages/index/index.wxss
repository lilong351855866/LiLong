page {
  /* 整体页面渐变背景 */
  background: linear-gradient(90deg, #083040, #2c1b50);
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  /* 底部避让自定义tab栏，防止内容被遮挡 */
  padding-bottom: calc(90rpx + env(safe-area-inset-bottom));
}

.page-root {
  width: 100%;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 4% 3%;
  box-sizing: border-box;
}

/* 顶部渐变光晕球体 */
.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 38vh;
  overflow: hidden;
  z-index: 0;
}
.gradient-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(14vw);
  opacity: 0.3;
}
.circle-1 {
  width: 28vw;
  height: 28vw;
  background: #38bdf8;
  top: 4vw;
  left: 8vw;
}
.circle-2 {
  width: 32vw;
  height: 32vw;
  background: #8b5cf6;
  top: 2vw;
  right: 6vw;
}

/* 标题文字样式+发光 */
.banner-box {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 6% 0 4%;
}
.banner-title {
  font-size: 13vw;
  font-weight: 900;
  letter-spacing: 1vw;
  background: linear-gradient(180deg, #ffffff, #40c4ff);
  -webkit-background-clip: text;
  color: transparent;
  text-shadow: 0 0 2.5vw #40c4ff, 0 0 5vw rgba(64, 196, 255, 0.4);
}
.banner-sub {
  font-size: 4vw;
  color: #c0c8dd;
  display: block;
  margin-top: 2%;
  letter-spacing: 0.5vw;
}

/* 顶部大图容器 */
.banner-img-box {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 48vw;
  border-radius: 4vw;
  overflow: hidden;
  box-shadow: 0 0 6vw rgba(56, 189, 248, 0.25);
  margin-bottom: 6%;
}
.show-img {
  width: 100%;
  height: 100%;
  display: block;
  transition: opacity 0.6s ease;
}
.img-mask {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 35%;
  background: linear-gradient(to top, rgba(8, 24, 40, 0.95), transparent);
}

/* 两行两列卡片布局 */
.card-grid {
  position: relative;
  z-index: 2;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5%;
}
.work-card {
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: 3vw;
  overflow: hidden;
  position: relative;
  box-shadow: 0 0 4vw rgba(56, 189, 248, 0.15);
}
.card-img {
  width: 100%;
  height: 100%;
  display: block;
}
.card-label {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 2.5vw 3%;
  font-size: 3.8vw;
  color: #ffffff;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  box-sizing: border-box;
}
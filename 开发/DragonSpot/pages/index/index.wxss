page {
  background: linear-gradient(90deg, #083040, #2c1b50);
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  padding-bottom: calc(90rpx + env(safe-area-inset-bottom));
}

.page-root {
  width: 100%;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 4% 3%;
  box-sizing: border-box;
}

.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 38vh;
  overflow: hidden;
  z-index: 0;
}
.gradient-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(14vw);
  opacity: 0.3;
}
.circle-1 {
  width: 28vw;
  height: 28vw;
  background: #38bdf8;
  top: 4vw;
  left: 8vw;
}
.circle-2 {
  width: 32vw;
  height: 32vw;
  background: #8b5cf6;
  top: 2vw;
  right: 6vw;
}

.banner-box {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 6% 0 4%;
}
.banner-title {
  font-size: 13vw;
  font-weight: 900;
  letter-spacing: 1vw;
  background: linear-gradient(180deg, #ffffff, #38bdf8, #8b5cf6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow:
    0 0 1.5vw rgba(56, 189, 248, 0.3),
    0 0 3vw rgba(100, 149, 237, 0.2),
    0 0 5vw rgba(139, 92, 246, 0.12);
}
.banner-sub {
  font-size: 4vw;
  color: #c0c8dd;
  display: block;
  margin-top: 2%;
  letter-spacing: 0.5vw;
}

.banner-img-box {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 48vw;
  border-radius: 4vw;
  overflow: hidden;
  box-shadow: 0 0 6vw rgba(56, 189, 248, 0.25);
  margin-bottom: 6%;
}
.show-img {
  width: 100%;
  height: 100%;
  display: block;
  transition: opacity 0.6s ease;
}
.img-mask {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 35%;
  background: linear-gradient(to top, rgba(8, 24, 40, 0.95), transparent);
}

.card-grid {
  position: relative;
  z-index: 2;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5%;
  margin-bottom:6%;
}
.work-card {
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: 3vw;
  overflow: hidden;
  position: relative;
  box-shadow: 0 0 4vw rgba(56, 189, 248, 0.15);
}
.card-img {
  width: 100%;
  height: 100%;
  display: block;
}
.card-label {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 2.5vw 3%;
  font-size: 3.8vw;
  color: #ffffff;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  box-sizing: border-box;
}

/* ===================== 赛博蓝光胶片滚动模块【圆孔优化版】 ===================== */
.film-container {
  width: 100%;
  height: 20vw;
  position: relative;
  overflow: hidden;
  z-index: 2;
  background: #050505;
  border: 1.4vw solid #121212;
  border-radius: 2vw;
  margin-bottom: 4%;

  box-shadow:
    0 0 1.2vw rgba(56, 189, 248, 0.6),
    0 0 2.4vw rgba(56, 189, 248, 0.35),
    0 0 4.8vw rgba(139, 92, 246, 0.25),
    inset 0 0 0 0.4vw rgba(56, 189, 248, 0.18);
}

/* 外围流动蓝光边框 */
.film-container::before {
  content: "";
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  border-radius: 2.4vw;
  background: linear-gradient(
    45deg,
    rgba(56, 189, 248, 0.8),
    rgba(139, 92, 246, 0.8),
    rgba(56, 189, 248, 0.8)
  );
  background-size: 300% 300%;
  animation: cyberGlow 3s ease infinite;
  z-index: -1;
}

/* 胶片上边缘蓝紫发光线 */
.film-container::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 0.3vw;
  background: linear-gradient(90deg, transparent, #38bdf8, #8b5cf6, transparent);
  z-index: 3;
}

/* 胶片上下圆孔：把黑点改成蓝紫发光小圆孔 */
.film-perforation-top,
.film-perforation-bottom {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2.6vw;
  z-index: 3;
  background-image:
    radial-gradient(circle at 4% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 8% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 12% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 16% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 20% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 24% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 28% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 32% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 36% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 40% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 44% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 48% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 52% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 56% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 60% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 64% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 68% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 72% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 76% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 80% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 84% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 88% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 92% 50%, rgba(56, 189, 248, 0.9) 0 0.75vw, transparent 0.85vw),
    radial-gradient(circle at 96% 50%, rgba(139, 92, 246, 0.9) 0 0.75vw, transparent 0.85vw);
}

.film-perforation-top {
  top: 0.8vw;
}

.film-perforation-bottom {
  bottom: 0.8vw;
}

.film-inner {
  width: 200%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.film-track {
  height: 100%;
  display: flex;
  align-items: center;
  animation: filmScroll 24s linear infinite;
}

.film-img {
  height: 15vw;
  width: 27vw;
  margin: 0 0.7vw;
  border-radius: 1vw;
  flex-shrink: 0;

  box-shadow:
    0 0 0 0.3vw rgba(56, 189, 248, 0.25),
    0 0 1.2vw rgba(56, 189, 248, 0.35),
    0 0 2.4vw rgba(139, 92, 246, 0.2);
}

@keyframes filmScroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@keyframes cyberGlow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
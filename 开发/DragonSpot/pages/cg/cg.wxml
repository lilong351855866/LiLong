<view class="cg-container">
  <view class="cg-header">
    <text class="cg-title">我的CG作品</text>
  </view>

  <scroll-view class="cg-list" scroll-y>
    <view class="cg-item" wx:for="{{cgList}}" wx:key="id">
      <!-- bindtap绑定到卡片，data-index放对位置 -->
      <view class="cg-card" bindtap="previewImage" data-index="{{index}}">
        <view class="watermark"></view>
        <image class="cg-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="cg-info">
          <text class="cg-name">{{item.name}}</text>
          <text class="cg-tag">{{item.tag}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<tab-bar active="1"></tab-bar>
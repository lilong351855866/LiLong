page {
  background-color: #121a2b;
  height: 100%;
  overflow-x: hidden;
}

.page-wrap {
  width: 100%;
  min-height: 100vh;
  padding: 0 24rpx;
  /* 90rpx本体高度 + 系统底部安全距离，刚好完整避开tab栏 */
  padding-bottom: calc(90rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.cg-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.cg-list > view:first-child {
  padding: 30rpx 0 10rpx 0;
  font-size: 44rpx;
  color: #38bdf8;
}

.card-box {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #1e293b;
}

.cg-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  display: block;
}

.desc {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.75), transparent);
  box-sizing: border-box;
}

.name {
  color: #ffffff;
  font-size: 40rpx;
}

.engine {
  color: #d1d5db;
  font-size: 26rpx;
  margin-top: 8rpx;
}
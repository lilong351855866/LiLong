page {
  background-color: #1e293b;
  color: #fff;
}

.cg-container {
  padding: 30rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.cg-header {
  margin-bottom: 30rpx;
}
.cg-title {
  font-size: 38rpx;
  color: #38bdf8;
  font-weight: bold;
}
.cg-list {
  height: calc(100vh - 150rpx);
}
.cg-item {
  margin-bottom: 30rpx;
}
.cg-card {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.cg-image {
  width: 100%;
  height: 100%;
  display: block;
}
.cg-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 25rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
}
.cg-name {
  font-size: 30rpx;
  color: #fff;
  display: block;
}
.cg-tag {
  font-size: 24rpx;
  color: #94a3b8;
}

.watermark {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  pointer-events: none;/* 允许点击穿透水印，最关键一行 */
}
.watermark::before {
  content: "画龙点景 · 个人娱乐";
  position: absolute;
  font-size: 28rpx;
  color: rgba(255,255,255,0.2);
  animation: watermarkMove 18s linear infinite;
  white-space: nowrap;
}
.watermark::after {
  content: "工坊视界";
  position: absolute;
  bottom: 22rpx;
  right: 28rpx;
  font-size: 24rpx;
  color: rgba(56, 189, 248, 0.3);
}
@keyframes watermarkMove {
  0% { transform: translate(100%, 80rpx); }
  100% { transform: translate(-100%, 80rpx); }
}